rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1) Varsayılan Güvenlik: Tüm genel okuma ve yazma işlemlerini reddet
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 2) Sude & Ahmet Özel Depolama Alanı
    // Sude'nin fotoğrafı yalnızca bu dizinde tutulur
    match /private/sude/{fileName} {
      // Yalnızca kimliği doğrulanmış Ahmet veya Sude dosyayı indirebilir/okuyabilir
      // NOT: Firebase Console kurulumunda gerçek UID'ler buraya girilmelidir.
      allow read: if request.auth != null && (
        request.auth.uid == 'AHMET_FIREBASE_UID_BURAYA' ||
        request.auth.uid == 'SUDE_FIREBASE_UID_BURAYA'
      );

      // Yalnızca Ahmet (yönetici) dosya yükleyebilir veya güncelleyebilir
      allow write: if request.auth != null &&
        request.auth.uid == 'AHMET_FIREBASE_UID_BURAYA' &&
        request.resource.size < 15 * 1024 * 1024 && // En fazla 15MB
        request.resource.contentType.matches('image/.*');
    }
  }
}
